{
  "name": "prismdock",
  "version": "1.3.0",
  "description": "A liquid-glass dock with live widgets that replaces the Windows taskbar.",
  "keywords": [
    "windows",
    "taskbar",
    "dock",
    "widgets",
    "electron",
    "liquid-glass",
    "webgl"
  ],
  "homepage": "https://github.com/Nico-Buck/prismdock#readme",
  "bugs": {
    "url": "https://github.com/Nico-Buck/prismdock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nico-Buck/prismdock.git"
  },
  "author": "Nico (https://github.com/Nico-Buck)",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dev": "set PRISM_DEBUG=1&& electron .",
    "test": "node --test \"tests/**/*.test.*\"",
    "dist": "electron-builder --win nsis portable",
    "check:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-native.ps1",
    "check:names": "node scripts/check-names.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "local.prismdock",
    "productName": "PrismDock",
    "asar": true,
    "files": [
      "src/**",
      "assets/**",
      "package.json",
      "!**/*.test.*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PrismDock"
    },
    "portable": {
      "artifactName": "PrismDock-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
